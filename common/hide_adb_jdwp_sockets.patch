+#else
 	.bind =		unix_bind,
 	.connect =	unix_stream_connect,
+#endif
 	.socketpair =	unix_socketpair,
 	.accept =	unix_accept,
@@ -847,6 +920,11 @@ static const struct proto_ops unix_dgram_ops = {
